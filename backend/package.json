{
  "name": "trip-expense-backend",
  "version": "1.0.0",
  "description": "Backend API for trip expense sharing",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:mongo": "tsx src/scripts/migrate-mongo-to-postgres.ts",
    "postinstall": "npm run build",
    "start": "node dist/server.js",
    "test": "vitest run src"
  },
  "keywords": [
    "expense",
    "trip",
    "sharing"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.6.0",
    "nanoid": "^3.3.7",
    "pg": "^8.23.0",
    "typescript": "^5.3.3",
    "zod": "^4.5.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "@protobufjs/utf8": "1.1.2",
    "@tootallnate/once": "2.0.1",
    "brace-expansion": "2.1.4",
    "form-data": "2.5.6",
    "minimatch": "9.0.7",
    "path-to-regexp": "0.1.13",
    "protobufjs": "7.6.5",
    "uuid": "11.1.1",
    "websocket-driver": "0.7.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.7.0",
    "vitest": "^4.1.11"
  }
}
