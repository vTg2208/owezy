PORT=3000
DATABASE_URL=postgres://<username>:<password>@<host>:5432/<database>
# Set to true for hosted PostgreSQL providers that require TLS.
DATABASE_SSL=false
# Path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
# Local development receipt storage. Leave unset to disable receipt uploads.
RECEIPT_STORAGE_ROOT=./var/receipts
RECEIPT_MAX_BYTES=5242880
# Unattached uploads remain pending for cleanup for this many hours.
RECEIPT_PENDING_TTL_HOURS=24

# Migration-source settings only; do not use MongoDB from runtime routes.
# MONGODB_URI=mongodb://localhost:27017/tripexpense
# MONGODB_DATABASE=tripexpense
