PORT=3000
# Comma-separated exact browser origins. Required when NODE_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgres://<username>:<password>@<host>:5432/<database>
# Set to true for hosted PostgreSQL providers that require TLS.
DATABASE_SSL=false
# Optional PEM CA for private/self-managed trust roots. Escaped \n sequences are supported.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
# Path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
# Production alternative: the complete Firebase service-account JSON as one secret value.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Receipt storage: disabled, local, or r2. Use r2 in horizontally scaled production.
RECEIPT_STORAGE_DRIVER=local
# Required only for the local driver.
RECEIPT_STORAGE_ROOT=./var/receipts
# Required only for the r2 driver. The endpoint may include an R2 jurisdiction.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=owezy-receipts
# R2_ACCESS_KEY_ID=<r2-access-key-id>
# R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
RECEIPT_MAX_BYTES=5242880
# Unattached uploads remain pending for cleanup for this many hours.
RECEIPT_PENDING_TTL_HOURS=24

# Migration-source settings only; do not use MongoDB from runtime routes.
# MONGODB_URI=mongodb://localhost:27017/tripexpense
# MONGODB_DATABASE=tripexpense
