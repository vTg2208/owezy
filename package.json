{
  "name": "trip-expense-manager",
  "version": "1.0.0",
  "description": "Trip expense sharing application",
  "private": true,
  "engines": {
    "node": ">=24.20.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint backend/src frontend/src frontend/vite.config.ts",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=high",
    "verify": "npm run lint && npm test && npm run build && npm run test:e2e && npm run audit:production && npm run audit:all",
    "start": "npm run start --workspace=trip-expense-backend"
  },
  "keywords": [
    "expense",
    "trip",
    "sharing"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.3.0",
    "typescript-eslint": "^8.42.0"
  }
}
